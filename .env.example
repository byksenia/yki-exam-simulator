# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is listed in .gitignore, so your key never ends up in git.
# Set up ONE of the options below, then restart the server (npm start).

# ── Option 1: Claude (Anthropic) ─────────────────────────────────────────────
# Create a key at https://console.anthropic.com/ → Settings → API keys.
ANTHROPIC_API_KEY=

# Optional: model used for rating (default claude-opus-5-5)
# YKI_MODEL=claude-opus-5-5
# Optional: model for the speaking interviewer's quick follow-up questions (default claude-sonnet-5-5)
# YKI_FAST_MODEL=claude-sonnet-5-5

# ── Option 2: ChatGPT (OpenAI) or another OpenAI-compatible API ─────────────
# Create a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# Optional: a cheaper/faster model for the interviewer's follow-up questions (default: OPENAI_MODEL)
# OPENAI_FAST_MODEL=

# Other providers with an OpenAI-compatible API: set the address too.
# (Only needed if ANTHROPIC_API_KEY is also set, or the provider needs no key)
# AI_PROVIDER=openai
#
# Google Gemini (key from https://aistudio.google.com/apikey):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.5-pro
#
# OpenRouter (one key for many models, https://openrouter.ai/keys):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-6.1-sol
#
# Ollama on your own computer (no key needed):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# ── Option 3: no key at all ──────────────────────────────────────────────────
# Leave everything empty and sign in to Claude Code (`claude auth login`) to rate
# with your Claude Pro/Max subscription.

# Optional: port (default 5173)
# PORT=5173
